# Postgres da VPS2 pelo pgbouncer (porta 6432)
DATABASE_URL=postgresql://natal_familia:SENHA@164.163.10.43:6432/natal_familia
# Conexão direta (só local, para rodar migrations/)
DATABASE_URL_DIRECT=postgresql://natal_familia:SENHA@164.163.10.43:5432/natal_familia?sslmode=require

# Assinatura da sessão: 64 caracteres aleatórios (openssl rand -hex 32)
SESSION_SECRET=

# Código que a família digita para se cadastrar
FAMILY_CODE=

# Vercel Blob (fotos)
BLOB_READ_WRITE_TOKEN=

# Cron da Vercel (conciliação dos Pix)
CRON_SECRET=

# C6 Bank (BolePIX, conta SpeedTech). Certificado e chave em base64 (base64 -w0 cert.crt)
C6_CLIENT_ID=
C6_CLIENT_SECRET=
C6_CERT_B64=
C6_KEY_B64=
C6_PIX_CHAVE=

# Push Android: JSON da conta de serviço Firebase em base64, com permissão FCM HTTP v1
FCM_SERVICE_ACCOUNT_B64=

# Push iOS: chave APNs .p8 em base64 e IDs da equipe/chave Apple
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_KEY_P8_B64=
# Padrão quando vazio: br.com.natalemfamilia.app
APNS_BUNDLE_ID=
# true para produção; false ou vazio para sandbox
APNS_PRODUCTION=

# Web Push (VAPID). Sem as três, o site funciona e só não manda aviso pelo navegador.
# Gere com: npx web-push generate-vapid-keys
# VAPID_SUBJECT é um mailto: de contato (ex.: mailto:pessoa@dominio)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

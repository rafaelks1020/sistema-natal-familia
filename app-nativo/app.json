{
  "expo": {
    "name": "Natal em Família",
    "slug": "natal-em-familia",
    "scheme": "natalemfamilia",
    "version": "1.2.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#171B18",
    "ios": {
      "bundleIdentifier": "br.com.natalemfamilia.app",
      "supportsTablet": false,
      "associatedDomains": [
        "applinks:natalemfamilia.com.br"
      ],
      "infoPlist": {
        "NSCameraUsageDescription": "Permita usar a câmera para compartilhar fotos com a família.",
        "NSPhotoLibraryUsageDescription": "Permita escolher fotos para compartilhar com a família.",
        "NSFaceIDUsageDescription": "Use o Face ID para desbloquear seu acesso à família.",
        "NSUserNotificationUsageDescription": "Receba avisos da ceia e novidades da família.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "buildNumber": "3",
      "appleTeamId": "6XKJ3V7VW5",
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.br.com.natalemfamilia.app"
        ]
      }
    },
    "android": {
      "package": "br.com.natalemfamilia.app",
      "adaptiveIcon": {
        "backgroundColor": "#171B18",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "natalemfamilia.com.br",
              "pathPrefix": "/entrar"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "permissions": [
        "android.permission.POST_NOTIFICATIONS"
      ],
      "predictiveBackGestureEnabled": true,
      "googleServicesFile": "./google-services.json",
      "versionCode": 3
    },
    "plugins": [
      "expo-router",
      "expo-image",
      [
        "expo-video",
        {
          "supportsBackgroundPlayback": false,
          "supportsPictureInPicture": false
        }
      ],
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true,
          "faceIDPermission": "Use o Face ID para desbloquear seu acesso à família."
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Permita usar a câmera para compartilhar fotos com a família.",
          "photosPermission": "Permita escolher fotos para compartilhar com a família.",
          "microphonePermission": false
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Use o Face ID para desbloquear seu acesso à família."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#C5292D",
          "defaultChannel": "familia",
          "enableRemoteNotifications": true
        }
      ],
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#171B18",
          "image": "./assets/splash-icon.png",
          "imageWidth": 160
        }
      ],
      "expo-sharing",
      [
        "expo-media-library",
        {
          "photosPermission": "O Natal em Família salva no seu aparelho as fotos da família que você escolher.",
          "savePhotosPermission": "O Natal em Família salva no seu aparelho as fotos da família que você escolher.",
          "isAccessMediaLocationEnabled": false,
          "granularPermissions": [
            "photo"
          ]
        }
      ],
      "./plugins/withAndroidSigning",
      [
        "expo-audio",
        {
          "microphonePermission": "O Natal em Família usa o microfone para gravar receitas e histórias da família.",
          "enableBackgroundPlayback": false,
          "enableBackgroundRecording": false
        }
      ],
      "@bacons/apple-targets",
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "NatalPequeno",
              "label": "Natal em Família (2x2)",
              "description": "Dias que faltam para a ceia",
              "minWidth": "110dp",
              "minHeight": "110dp",
              "targetCellWidth": 2,
              "targetCellHeight": 2,
              "resizeMode": "none",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "NatalGrande",
              "label": "Natal em Família (4x2)",
              "description": "Dias, horas e o título da ceia",
              "minWidth": "250dp",
              "minHeight": "110dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "resizeMode": "none",
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
